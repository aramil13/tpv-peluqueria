{
  "appId": "com.peluqueria.tpv",
  "asar": false,
  "files": [
    ".env.local",
    "electron-app.html",
    "main.js",
    "preload.js",
    "sync-helper.js",
    "package.json",
    "booking/**",
    "lib/**",
    "scripts/**",
    "website/**",
    "sync/"
  ],
  "win": {
    "target": ["portable", "nsis"],
    "icon": "icon.png",
    "artifactName": "TPV-Builder2-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "installerIcon": "icon.ico",
    "artifactName": "TPV-Builder2-Installer-${version}.${ext}"
  }
}
