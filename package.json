{
  "name": "tpv-peluqueria",
  "version": "1.11.0",
  "description": "TPV Agenda para Peluquería",
  "author": "Nymara",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:android": "cd android-agenda && npx cap copy android && cd android && gradlew assembleDebug && copy app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\agendaTPV.apk"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "appId": "com.peluqueria.tpv",
  "files": [
    "electron-app.html",
    "main.js",
    "preload.js",
    "sync-helper.js",
    "package.json",
    "booking/**",
    "lib/**",
    "scripts/**",
    "website/**",
    ".env*"
  ],
  "win": {
    "target": "portable",
    "icon": "icon.png"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "dotenv": "^16.4.0"
  }
}
