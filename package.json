{
  "name": "tpv-peluqueria",
  "version": "1.11.0",
  "description": "TPV Agenda para Peluquería",
  "author": "Nymara",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:android": "cd android-agenda && npx cap copy android && cd android && gradlew assembleDebug && copy app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\agendaTPV.apk"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "nodemailer": "^6.9.0"
  },
  "build": {
    "appId": "com.peluqueria.tpv",
    "productName": "TPV Peluquería",
    "files": [
      "electron-app.html",
      "main.js",
      "preload.js",
      "sync-helper.js",
      "package.json",
      "node_modules/**",
      "booking/**",
      "lib/**",
      "scripts/**",
      "website/**",
      ".env*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}

